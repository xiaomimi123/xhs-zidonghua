+# 截图格式：默认 JPEG；XHS_SHOT_FORMAT=png 换回 PNG；浏览器忽略 type 参数写出 PNG 时按文件头改成 .png；JPEG 失败退回 PNG
+shot_test() { # 名称 期望扩展名 期望文件头(十六进制前两字节) 环境变量...
+  name=$1; ext=$2; magic=$3; shift 3
+  H2=$(mktemp -d)
+  env "$@" HOME="$H2" FAKE_MODE=ok FAKE_Q=创业 node collector.js --keyword 创业 --limit 2 >/tmp/xhs-t.out 2>/tmp/xhs-t.err; c=$?
+  f=$(ls "$H2/xhs-collector/shots/"*.$ext 2>/dev/null | head -1)
+  other=$(ls "$H2/xhs-collector/shots/" 2>/dev/null | grep -v "\.$ext$" | head -1)
+  if [ $c = 0 ] && [ -n "$f" ] && [ -z "$other" ] && [ "$(head -c 2 "$f" | od -An -tx1 | tr -d ' \n')" = "$magic" ] && grep -q "\"screenshot_path\": \".*\.$ext\"" /tmp/xhs-t.out; then echo "PASS shot-$name exit=$c file=$(basename "$f")"; else echo "FAIL shot-$name exit=$c file=$f other=$other"; tail -3 /tmp/xhs-t.err; fi
+}
