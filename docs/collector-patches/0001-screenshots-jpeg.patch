+// 不留下「扩展名和内容对不上」的文件；JPEG 截图失败就退回 PNG 再试一次。返回最终的文件路径。
+const takeShot = async (base) => {
+  if (P.shotType === 'png') { const f = base + '.png'; await page.screenshot({ path: f }); return f }
+  const jpg = base + '.jpg'
+  try {
+    await page.screenshot({ path: jpg, type: 'jpeg', quality: P.shotQuality || 80 })
+    const head = fs.readFileSync(jpg).subarray(0, 4)
+    if (head[0] === 0x89 && head[1] === 0x50) { const png = base + '.png'; fs.renameSync(jpg, png); return png }
+    return jpg
+  } catch (e) {
+    try { fs.rmSync(jpg, { force: true }) } catch {}
+    const png = base + '.png'
+    await page.screenshot({ path: png })
+    return png
+  }
+}
